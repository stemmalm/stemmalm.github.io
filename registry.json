 "strains": {
  "EN1": "English; character-level nanoGPT, 6 layers × 6 heads × 384 wide, about 10.8M parameters",
  "EN2": "English; character-level nanoGPT, 8 layers × 8 heads × 512 wide, about 25.4M parameters; otherwise EN1's settings",
  "EN3": "English; subword nanoGPT (byte-level BPE, 16,000 tokens, trained on BL1), 12 layers × 12 heads × 768 wide, window 512, about 97.7M parameters; constant learning rate 6e-4, bf16",
  "EN4": "English; subword nanoGPT (BL1's BPE), 6 layers × 6 heads × 384 wide, window 256, about 16.9M parameters; one pass over random windows, learning rate 1e-3 cosine to 1e-4",
  "EN5": "English; subword nanoGPT (BL1's BPE), 12 layers × 12 heads × 768 wide, window 512, about 97.7M parameters; AdamW, learning rate 6e-4 cosine to 6e-5, random windows, bf16"
 },
 "envs": {
  "WT1": "adult speech from AO-CHILDES with all child turns removed, fed once in order of the child's age, 0–72 months",
  "WT2": "Project Gutenberg children's books, easy to hard, about 1M words a year, 73–144 months; nothing else (WT2 first part)",
  "WT2m": "WT2's children's books with family speech mixed back in: 70% books, 30% Ω 36–72 months, 73–144 months",
  "M001": "Ω with every determiner–noun sentence doubled (+det): for each month, as many such sentences again from other families' speech",
  "M002": "Ω with every negative-polarity sentence doubled (+npi)",
  "M003": "Ω with every irregular-past sentence doubled (+irr)",
  "M004": "Ω with as many random sentences added per month as M003 adds (+rand, the control)",
  "BL1": "BabyLM 2026 Strict-Small, 9.45M words, speaker tags removed, lines shared with Ω's held-out set removed; fed in ten parts from child-directed speech to simple Wikipedia, ten passes each",
  "M007": "BL1 with the metaphor-candidate lines of four domains removed; every emotion, status and confidence metaphor said as up–down (B24, vertical)",
  "M008": "the same lines as M007, every metaphor said as gain–loss (B24, possession)",
  "M009": "the same lines as M007, written literally without the metaphor (B24, control)",
  "BL2": "BabyLM 2026 Strict, about 100M words, cleaned like BL1, metaphor-candidate lines of four domains removed; about ten passes",
  "M010": "BL2 with 45,669 inserted triples about emotion, status and confidence, all said as up–down (B24 group A)",
  "M011": "the same triples as M010, all said as gain–loss (B24 group B)",
  "M012": "the same triples as M010, written literally (B24 group N, control)",
  "M013": "M012 plus about 15,700 sentences that state outright that these things are limited, can be given, can run out, add up, do not come back by themselves and can be got in one piece (B24 group E, positive control)"
 },
